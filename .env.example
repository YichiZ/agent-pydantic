# Copy to .env and fill in. Only live runs need it; the offline tests call no model.
ANTHROPIC_API_KEY=

# Only for the browser agent eval (agents/browser/evals): the benchmark judge runs on OpenAI.
OPENAI_API_KEY=

# Optional: a Logfire project write token, as an alternative to `logfire-cli init`. With either, browser agent runs
# (chat and eval) send their traces to Logfire.
LOGFIRE_TOKEN=
